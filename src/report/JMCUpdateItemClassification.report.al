report 53328 "JMC Update Item Classification"
{
    Caption = 'Update Item Classification 2027', Comment = 'ESP="Actualizar clasificación de productos 2027"';
    ProcessingOnly = true;
    UsageCategory = Administration;
    ApplicationArea = All;

    dataset
    {
        dataitem(Integer; Integer)
        {
            DataItemTableView = sorting(Number) where(Number = const(1));

            trigger OnAfterGetRecord()
            begin
                LoadItems();
                CountChanges();
                if PreviewOnly then begin
                    Message(PreviewMsg, UpdatedCount, UnchangedCount, NotFoundCount, InvalidCount, InvalidItems);
                    exit;
                end;

                if not Confirm(ConfirmUpdateQst, false, UpdatedCount, UnchangedCount, NotFoundCount, InvalidCount, InvalidItems) then
                    exit;

                ApplyItems();
                Message(CompletedMsg, UpdatedCount, UnchangedCount, NotFoundCount, InvalidCount, InvalidItems);
            end;
        }
    }

    requestpage
    {
        layout
        {
            area(Content)
            {
                group(Options)
                {
                    Caption = 'Options', Comment = 'ESP="Opciones"';
                    field(PreviewOnly; PreviewOnly)
                    {
                        ApplicationArea = All;
                        Caption = 'Preview Only', Comment = 'ESP="Solo simulación"';
                        ToolTip = 'Shows the number of items to update without changing data.', Comment = 'ESP="Muestra el número de productos que se actualizarían sin modificar datos."';
                    }
                }
            }
        }
    }

    trigger OnInitReport()
    begin
        PreviewOnly := true;
    end;

    local procedure CountChanges()
    var
        Item: Record Item;
    begin
        UpdatedCount := 0;
        UnchangedCount := 0;
        NotFoundCount := 0;
        InvalidCount := 0;
        InvalidItems := '';
        Item.SetLoadFields("JMC Category Type", "Item Category Code", "JMC Sub Item Category Code");
        if TempItem.FindSet() then
            repeat
                if not Item.Get(TempItem."No.") then
                    NotFoundCount += 1
                else
                    if not IsClassificationValid(TempItem) then begin
                        InvalidCount += 1;
                        AddInvalidItem(TempItem."No.");
                    end else
                        if ClassificationDiffers(Item, TempItem) then
                            UpdatedCount += 1
                        else
                            UnchangedCount += 1;
            until TempItem.Next() = 0;
    end;

    local procedure ApplyItems()
    var
        Item: Record Item;
        JMCItemClassSubscribers: Codeunit "JMC Item Class. Subscribers";
    begin
        BindSubscription(JMCItemClassSubscribers);
        if TempItem.FindSet() then
            repeat
                if Item.Get(TempItem."No.") then
                    if IsClassificationValid(TempItem) and ClassificationDiffers(Item, TempItem) then begin
                        Item.Validate("JMC Category Type", TempItem."JMC Category Type");
                        if Item."Item Category Code" <> TempItem."Item Category Code" then
                            Item.Validate("Item Category Code", TempItem."Item Category Code");
                        Item.Validate("JMC Sub Item Category Code", TempItem."JMC Sub Item Category Code");
                        Item.Modify(true);
                    end;
            until TempItem.Next() = 0;
        UnbindSubscription(JMCItemClassSubscribers);
    end;

    local procedure ClassificationDiffers(Item: Record Item; DesiredItem: Record Item temporary): Boolean
    begin
        exit((Item."JMC Category Type" <> DesiredItem."JMC Category Type") or
             (Item."Item Category Code" <> DesiredItem."Item Category Code") or
             (Item."JMC Sub Item Category Code" <> DesiredItem."JMC Sub Item Category Code"));
    end;

    local procedure IsClassificationValid(DesiredItem: Record Item temporary): Boolean
    begin
        exit(CategoryHasType(DesiredItem."Item Category Code", DesiredItem."JMC Category Type") and
             CategoryHasType(DesiredItem."JMC Sub Item Category Code", DesiredItem."JMC Category Type"));
    end;

    local procedure CategoryHasType(CategoryCode: Code[20]; CategoryType: Enum "JMC Category Type"): Boolean
    var
        ItemCategory: Record "Item Category";
    begin
        ItemCategory.SetRange(Code, CategoryCode);
        ItemCategory.SetRange("JMC Category Type", CategoryType);
        exit(not ItemCategory.IsEmpty());
    end;

    local procedure AddInvalidItem(ItemNo: Code[20])
    begin
        if StrLen(InvalidItems) > 200 then
            exit;
        if InvalidItems <> '' then
            InvalidItems += ', ';
        InvalidItems += ItemNo;
    end;

    local procedure AddItem(ItemNo: Code[20]; CategoryType: Enum "JMC Category Type"; ItemCategoryCode: Code[20]; SubItemCategoryCode: Code[20])
    begin
        TempItem.Init();
        TempItem."No." := ItemNo;
        TempItem."JMC Category Type" := CategoryType;
        TempItem."Item Category Code" := ItemCategoryCode;
        TempItem."JMC Sub Item Category Code" := SubItemCategoryCode;
        TempItem.Insert();
    end;

