<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- Header: Logo + Company Info -->
          <Rectangle Name="HeaderRectangle">
            <ReportItems>
              <!-- Company Logo -->
              <Image Name="CompanyLogo">
                <Source>Database</Source>
                <Value>=Fields!CompanyPicture.Value</Value>
                <MIMEType>image/jpeg</MIMEType>
                <Sizing>FitProportional</Sizing>
                <Top>0.2cm</Top>
                <Left>0.5cm</Left>
                <Height>3cm</Height>
                <Width>6cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Image>
              <!-- Company Info - Top Right Corner -->
              <Textbox Name="CompanyInfoCompact">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!CompanyName.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=vbCrLf &amp; Fields!CompanyVATRegistrationNo.Value &amp; vbCrLf &amp;
Fields!CompanyAddress.Value &amp; ", " &amp; Fields!CompanyPostCode.Value &amp; vbCrLf &amp;
Fields!CompanyCity.Value &amp; ", " &amp; Fields!CompanyCounty.Value &amp; vbCrLf &amp;
Fields!CompanyPhoneNo.Value &amp; vbCrLf &amp; Fields!CompanyEMail.Value &amp; vbCrLf &amp;
Fields!CompanyHomePage.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.6cm</Top>
                <Left>11.5cm</Left>
                <Height>2cm</Height>
                <Width>8cm</Width>
                <ZIndex>1</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <!-- VENTA - PROFORMA Box -->
              <Rectangle Name="TitleBox">
                <ReportItems>
                  <Textbox Name="TitleText">
                    <CanGrow>true</CanGrow>
                    <KeepTogether>true</KeepTogether>
                    <Paragraphs>
                      <Paragraph>
                        <TextRuns>
                          <TextRun>
                            <Value>PEDIDO
VENTA</Value>
                            <Style>
                              <FontFamily>Arial</FontFamily>
                              <FontSize>10pt</FontSize>
                              <FontWeight>Bold</FontWeight>
                              <Color>Black</Color>
                            </Style>
                          </TextRun>
                        </TextRuns>
                        <Style>
                          <TextAlign>Center</TextAlign>
                        </Style>
                      </Paragraph>
                    </Paragraphs>
                    <Top>0.1cm</Top>
                    <Left>0.1cm</Left>
                    <Height>1.3cm</Height>
                    <Width>2.3cm</Width>
                    <Style>
                      <Border>
                        <Style>None</Style>
                      </Border>
                      <VerticalAlign>Middle</VerticalAlign>
                    </Style>
                  </Textbox>
                </ReportItems>
                <KeepTogether>true</KeepTogether>
                <Top>2.5cm</Top>
                <Left>0.5cm</Left>
                <Height>1.5cm</Height>
                <Width>2.5cm</Width>
                <ZIndex>2</ZIndex>
                <Style>
                  <Border>
                    <Style>Solid</Style>
                    <Width>2pt</Width>
                  </Border>
                  <BackgroundColor>White</BackgroundColor>
                </Style>
              </Rectangle>
              <!-- Quote Number -->
              <Textbox Name="QuoteNumber">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!No_SalesHeader.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>11pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>3.2cm</Top>
                <Left>3.2cm</Left>
                <Height>0.6cm</Height>
                <Width>4cm</Width>
                <ZIndex>3</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
            </ReportItems>
            <KeepTogether>true</KeepTogether>
            <Top>0.2cm</Top>
            <Left>0.2cm</Left>
            <Height>4.5cm</Height>
            <Width>19.6cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>
          <!-- DATOS CLIENTE Section -->
          <Rectangle Name="CustomerSection">
            <ReportItems>
              <!-- Header -->
              <Textbox Name="CustomerSectionHeader">
                <CanGrow>false</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>DATOS CLIENTE</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0cm</Top>
                <Left>0cm</Left>
                <Height>0.6cm</Height>
                <Width>19.6cm</Width>
                <Style>
                  <Border>
                    <Style>Solid</Style>
                  </Border>
                  <BackgroundColor>#B91921</BackgroundColor>
                  <PaddingLeft>5pt</PaddingLeft>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <!-- Customer Data - Column 1 Labels -->
              <Textbox Name="CustomerLabelsCol1">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Nº Cliente
Nombre cliente
CIF
Dirección
Código postal
Provincia</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>7.5pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.7cm</Top>
                <Left>0.2cm</Left>
                <Height>2cm</Height>
                <Width>2.5cm</Width>
                <ZIndex>1</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                </Style>
              </Textbox>
              <!-- Customer Data - Column 1 Values -->
              <Textbox Name="CustomerDataCol1">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!SelltoCustomerNo_SalesHeader.Value &amp; vbCrLf &amp;
Fields!SelltoCustomerName_SalesHeader.Value &amp; vbCrLf &amp;
Fields!CustomerVATRegistrationNo.Value &amp; vbCrLf &amp;
Fields!SelltoAddress_SalesHeader.Value &amp; vbCrLf &amp;
Fields!SelltoPostCode_SalesHeader.Value &amp; vbCrLf &amp;
Fields!SelltoCounty_SalesHeader.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>7.5pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.7cm</Top>
                <Left>2.8cm</Left>
                <Height>2cm</Height>
                <Width>6.5cm</Width>
                <ZIndex>2</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <!-- Customer Data - Column 2 Labels -->
              <Textbox Name="CustomerLabelsCol2">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Dirección de envío
Código postal
Localidad
Provincia
Persona de contacto
Nº de teléfono
Correo electrónico</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>7.5pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.7cm</Top>
                <Left>9.8cm</Left>
                <Height>2cm</Height>
                <Width>3cm</Width>
                <ZIndex>3</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                </Style>
              </Textbox>
              <!-- Customer Data - Column 2 Values -->
              <Textbox Name="CustomerDataCol2">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!ShiptoAddress_SalesHeader.Value &amp; vbCrLf &amp;
Fields!ShiptoPostCode_SalesHeader.Value &amp; vbCrLf &amp;
Fields!ShiptoCity_SalesHeader.Value &amp; vbCrLf &amp;
Fields!ShiptoCounty_SalesHeader.Value &amp; vbCrLf &amp;
Fields!SelltoContactNo_SalesHeader.Value &amp; vbCrLf &amp;
Fields!SelltoPhoneNo_SalesHeader.Value &amp; vbCrLf &amp;
Fields!SelltoEMail_SalesHeader.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>7.5pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.7cm</Top>
                <Left>12.9cm</Left>
                <Height>2cm</Height>
                <Width>6.5cm</Width>
                <ZIndex>4</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
            </ReportItems>
            <KeepTogether>true</KeepTogether>
            <Top>5cm</Top>
            <Left>0.2cm</Left>
            <Height>3cm</Height>
            <Width>19.6cm</Width>
            <ZIndex>1</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>
          <!-- Separator Line -->
          <Line Name="SeparatorLine">
            <Top>8.1cm</Top>
            <Left>0.2cm</Left>
            <Width>19.6cm</Width>
            <Height>0cm</Height>
            <ZIndex>2</ZIndex>
            <Style>
              <Border>
                <Style>Solid</Style>
                <Color>#000000</Color>
                <Width>0.5pt</Width>
              </Border>
            </Style>
          </Line>
          <!-- Dates and Payment Section - Reorganized -->
          <Rectangle Name="DatesSection">
            <ReportItems>
              <!-- LEFT SECTION: Dates -->
              <!-- Fecha de emisión Label -->
              <Textbox Name="IssueDateLabel">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Fecha de emisión:</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.2cm</Top>
                <Left>0.2cm</Left>
                <Width>2.5cm</Width>
                <Height>0.5cm</Height>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <Textbox Name="IssueDateValue">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!DocumentDate_SalesHeader.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.2cm</Top>
                <Left>2.8cm</Left>
                <Width>6cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>1</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <!-- Fecha entrega Label -->
              <Textbox Name="DeliveryDateLabel">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Fecha entrega:</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.6cm</Top>
                <Left>0.2cm</Left>
                <Width>2.5cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>2</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <Textbox Name="DeliveryDateValue">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!RequestedDeliveryDate_SalesHeader.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.6cm</Top>
                <Left>2.8cm</Left>
                <Width>6cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>3</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <!-- RIGHT SECTION: Payment Terms and Bank -->
              <!-- Término de pago Label -->
              <Textbox Name="PaymentTermsLabel">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Término de pago:</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.2cm</Top>
                <Left>9.8cm</Left>
                <Width>3cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>4</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <Textbox Name="PaymentTermsValue">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Fields!PaymentTermsDescription.Value</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.2cm</Top>
                <Left>12.9cm</Left>
                <Width>6.7cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>5</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <!-- Banco Label -->
              <Textbox Name="BankLabel">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Banco:</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Right</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.2cm</Top>
                <Left>15.5cm</Left>
                <Width>1.3cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>6</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                  <TextAlign>Right</TextAlign>
                </Style>
              </Textbox>
              <Textbox Name="BankValue">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=First(Fields!CompanyBankName.Value, "DataSet_Result")</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.2cm</Top>
                <Left>16.9cm</Left>
                <Width>2.7cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>7</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <!-- Nº de Cuenta (IBAN) Label -->
              <Textbox Name="IBANLabel">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Nº de Cuenta:</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.6cm</Top>
                <Left>9.8cm</Left>
                <Width>3cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>8</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
              <Textbox Name="IBANValue">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=First(Fields!CompanyBankIBAN.Value, "DataSet_Result")</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.6cm</Top>
                <Left>12.9cm</Left>
                <Width>6.7cm</Width>
                <Height>0.5cm</Height>
                <ZIndex>9</ZIndex>
                <Style>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
              </Textbox>
            </ReportItems>
            <KeepTogether>true</KeepTogether>
            <Top>8.3cm</Top>
            <Left>0.2cm</Left>
            <Height>1.6cm</Height>
            <Width>19.6cm</Width>
            <ZIndex>3</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>
          <!-- Lines Table -->
          <Tablix Name="LinesTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>2cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>5cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.5cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.5cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.8cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.8cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.5cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.8cm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2.7cm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- Header Row -->
                <TablixRow>
                  <Height>0.6cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HeaderCodigo">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Código</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>HeaderCodigo</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>White</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#B91921</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HeaderDescripcion">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Descripción</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>HeaderDescripcion</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>White</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#B91921</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
