                        <Width>0.5pt</Width>
                      </Border>
                    </Style>
                  </Line>
                  <!-- Firma -->
                  <Textbox Name="FirmaLabel">
                    <CanGrow>false</CanGrow>
                    <Paragraphs>
                      <Paragraph>
                        <TextRuns>
                          <TextRun>
                            <Value>Firma:</Value>
                            <Style>
                              <FontFamily>Arial</FontFamily>
                              <FontSize>8pt</FontSize>
                            </Style>
                          </TextRun>
                        </TextRuns>
                        <Style>
                          <TextAlign>Left</TextAlign>
                        </Style>
                      </Paragraph>
                    </Paragraphs>
                    <Top>1.6cm</Top>
                    <Left>5.2cm</Left>
                    <Height>0.4cm</Height>
                    <Width>4.8cm</Width>
                    <ZIndex>8</ZIndex>
                    <Style>
                      <Border>
                        <Style>None</Style>
                      </Border>
                    </Style>
                  </Textbox>
                </ReportItems>
                <KeepTogether>true</KeepTogether>
                <Top>0.2cm</Top>
                <Left>9.4cm</Left>
                <Height>3cm</Height>
                <Width>10.3cm</Width>
                <ZIndex>1</ZIndex>
                <Style>
                  <Border>
                    <Style>Solid</Style>
                    <Color>#000000</Color>
                    <Width>0.5pt</Width>
                  </Border>
                </Style>
              </Rectangle>
              <!-- Horizontal divider line below boxes -->
              <Line Name="FooterDividerLine">
                <Top>3.2cm</Top>
                <Left>0cm</Left>
                <Height>0cm</Height>
                <Width>19.7cm</Width>
                <ZIndex>2</ZIndex>
                <Style>
                  <Border>
                    <Color>#000000</Color>
                    <Style>Solid</Style>
                    <Width>0.5pt</Width>
                  </Border>
                </Style>
              </Line>
              <!-- Footer Text Red -->
              <Textbox Name="FooterTextRed">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Rellenar todos los datos junto al sello de recepción.</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#B91921</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Right</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>3.3cm</Top>
                <Left>3.5cm</Left>
                <Height>0.4cm</Height>
                <Width>16.2cm</Width>
                <ZIndex>3</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <!-- SELLO Text -->
              <Textbox Name="SelloText">
                <CanGrow>false</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>SELLO:</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>9pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>3.8cm</Top>
                <Left>0cm</Left>
                <Height>0.4cm</Height>
                <Width>19.6cm</Width>
                <ZIndex>3</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <!-- Footer Instructions Text -->
              <Textbox Name="FooterInstructions">
                <CanGrow>true</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>No se aceptan devoluciones de producto pasadas 24h desde la recepción del pedido.

</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>RECEPCIÓN Y REVISIÓN DEL PEDIDO RECIBIDO</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>

- </Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>Imprescindible</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>: Al recibir el pedido a través de la agencia correspondiente, deberá revisar que el número de bultos recibidos sea el mismo que se indica en el albarán y que no se observa ninguna anomalía (bultos golpeados, rotos, abiertos, etc.), así mismo, que la temperatura es la correcta de conservación.

- En caso de alguna </Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>incidencia con los bultos</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>, deberá dejar la observación en el albarán del transporte, hacer la devolución inmediata de los bultos afectados con el chofer de la agencia, debiendo estar presente al momento de la descarga/carga y notificarlo dentro de las 24h siguientes a la entrega del pedido.

- Correos oficiales en caso de incidencias: administracion@comidaspopulares.com / javier.lorenzo@comidaspopulares.com</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>6pt</FontSize>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                      <LineHeight>7pt</LineHeight>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>7.5cm</Top>
                <Left>0cm</Left>
                <Height>2.5cm</Height>
                <Width>19.6cm</Width>
                <ZIndex>4</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
            </ReportItems>
            <Top>15.5cm</Top>
            <Left>0.2cm</Left>
            <Height>9cm</Height>
            <Width>19.6cm</Width>
            <ZIndex>5</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>
        </ReportItems>
        <Height>24.5cm</Height>
        <Style />
